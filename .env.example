# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and anon public API key.
# When provided, all bookings, services, and admin operations connect directly to PostgreSQL on Supabase.
# If not yet set, the applet operates in interactive demo mode with persistent local storage so all features remain testable.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
